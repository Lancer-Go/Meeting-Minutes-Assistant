# 复制本文件为 .env 并填入密钥（.env 已被 .gitignore 忽略）
# 不填密钥也能跑通：ASR 用本地 whisper，LLM 用本地抽取式基线。

# ---- Provider 选择 ----
# MMA_ASR=whisper          # whisper | aliyun | tencent | iflytek
# MMA_LLM=extractive       # deepseek | qwen | extractive
# MMA_WHISPER_MODEL=base   # tiny/base/small/medium/large-v3
# MMA_LLM_MAX_CHARS=12000  # LLM Map-Reduce 分块阈值（字符）

# ---- 阿里云 DashScope（Paraformer 录音文件识别）----
# DASHSCOPE_API_KEY=

# ---- 腾讯云（录音文件识别）----
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=

# ---- 讯飞（暂占位，未接入 LFASR）----
# XFYUN_APP_ID=
# XFYUN_API_KEY=
# XFYUN_API_SECRET=

# ---- LLM ----
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# OPENAI_API_KEY=
