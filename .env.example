# 复制本文件为 .env 并填入密钥（.env 已被 .gitignore 忽略）
# 不填密钥也能跑通：ASR 用本地 whisper，LLM 用本地抽取式基线。

# ---- Provider 选择 ----
# MMA_ASR=whisper          # whisper | aliyun | tencent | iflytek
# MMA_LLM=extractive       # deepseek | qwen | extractive
# MMA_WHISPER_MODEL=base   # tiny/base/small/medium/large-v3
# MMA_LLM_MAX_CHARS=12000  # LLM Map-Reduce 分块阈值（字符）

# ---- 阿里云智能语音交互（NLS）录音文件识别：AppKey + AccessKey + OSS 桶 ----
# ALIYUN_APP_KEY=
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com

# ---- 阿里云 DashScope（备选，需 sk- 开头的 DashScope API Key）----
# DASHSCOPE_API_KEY=

# ---- 腾讯云（录音文件识别）----
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=

# ---- 讯飞（暂占位，未接入 LFASR）----
# XFYUN_APP_ID=
# XFYUN_API_KEY=
# XFYUN_API_SECRET=

# ---- LLM ----
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# OPENAI_API_KEY=

# ---- 服务配置 (M1) ----
# MMA_ASR=tencent          # tencent | aliyun | whisper | iflytek（云端无密钥自动降级 whisper）
# MMA_LLM=deepseek         # deepseek | qwen | extractive（无密钥自动降级 extractive）
# MMA_WHISPER_MODEL=base   # 本地兜底模型
# MMA_LLM_MAX_CHARS=12000  # Map-Reduce 分块阈值（字符）
# MMA_DEEPSEEK_MODEL=deepseek-v4-pro  # DeepSeek 主用模型（默认 deepseek-v4-pro）
# MMA_DATA_DIR=data        # 数据目录（上传/任务产物/SQLite）
# MMA_HOST=127.0.0.1
# MMA_PORT=8000
# MMA_MAX_FILE_SIZE_MB=2048      # 上传大小上限（默认 2GB）
# MMA_MAX_DURATION_SECONDS=7200  # 会议时长上限（默认 2 小时）
# MMA_ASR_CHUNK_SECONDS=100      # 腾讯云切片时长（base64 ≤5MB ≈2min）

# ============================================================================
# ---- M3 · 生产化（TG-0~TG-7）----
# ============================================================================

# ---- 存储（TG-2）：SQLite → PostgreSQL；本地文件 → MinIO ----
# DATABASE_URL=postgresql://mma:mma@localhost:5432/mma   # 空 = 本地 SQLite（DB_PATH）
# MMA_DB_PATH=data/mma.db                                # SQLite 文件位置（本地开发）
# S3_ENDPOINT=http://localhost:9000                      # 空 = 本地 FS 兜底
# S3_BUCKET=mma
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# S3_SSE_ENABLED=false            # 服务端加密：生产 COS/S3 设 true；本地 MinIO（无 KES）保持 false，否则上传报 KMS not configured

# ---- 队列（TG-0）：Celery + Redis ----
# MMA_USE_CELERY=true            # true = Celery 队列；false = BackgroundTasks（本地开发）
# REDIS_URL=redis://localhost:6379/0

# ---- 鉴权（TG-4）：自建账号体系 + JWT ----
# MMA_AUTH_ENABLED=true          # false = 业务接口免鉴权（本地开发/测试）
# JWT_SECRET=please-change-me-to-a-long-random-secret   # ⚠️ 生产必须覆盖（≥32 字节）
# JWT_EXPIRE_MINUTES=10080       # token 有效期（分钟，默认 7 天）
# PASSWORD_BCRYPT_ROUNDS=12

# ---- 加密（TG-4）：AES-256-GCM ----
# AES_KEY=                       # 空则从 JWT_SECRET 派生（开发默认）；生产建议 32 字节随机

# ---- 成本（TG-6）----
# COST_LIMIT_DAILY_RMB=5.0       # 日成本限额（元）
# COST_LIMIT_PER_TASK_RMB=1.0    # 单场超预算阈值（元）
# COST_AUTO_PAUSE=false          # 超限自动暂停新任务（默认关闭，避免误伤）

# ---- 可观测（TG-3）----
# MMA_METRICS_ENABLED=true       # 是否暴露 /metrics 指标端点

# ---- 部署（TG-7）----
# POSTGRES_PASSWORD=mma          # compose 内 PG 密码
# GRAFANA_ADMIN_PASSWORD=admin   # Grafana 初始密码（首登后请改）
